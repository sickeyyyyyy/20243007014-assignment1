<?xml version="1.0" encoding="utf-8"?>
<!--
    Button selector for the four service ImageButtons.
    Green by default; light green while pressed.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@color/light_green" />
    <item android:drawable="@color/green" />
</selector>