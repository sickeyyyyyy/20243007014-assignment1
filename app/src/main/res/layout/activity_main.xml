<?xml version="1.0" encoding="utf-8"?>
<!--
    Main screen (portrait).
    Top: campus banner with the welcome heading overlaid.
    Bottom: 2 x 2 grid of service buttons (Facilities, Events, Clubs, Support).
    Sizes use layout weights and match_parent so the layout stays responsive;
    the only fixed text size is the 40sp banner heading allowed by the spec.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Banner image with overlaid welcome heading. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/bannerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_main_banner" />

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:text="@string/welcome_title"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="40sp" />
    </FrameLayout>

    <!-- Service button grid: two rows, two columns. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/green"
        android:padding="@dimen/cell_spacing">

        <!-- First row: Facilities, Events. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/cell_spacing">

                <ImageButton
                    android:id="@+id/btnFacilities"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_service"
                    android:contentDescription="@string/label_facilities"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_facilities" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/label_facilities"
                    android:textColor="@color/white"
                    android:textSize="@dimen/service_label_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/cell_spacing">

                <ImageButton
                    android:id="@+id/btnEvents"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_service"
                    android:contentDescription="@string/label_events"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_events" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/label_events"
                    android:textColor="@color/white"
                    android:textSize="@dimen/service_label_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Second row: Clubs, Support. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/cell_spacing">

                <ImageButton
                    android:id="@+id/btnClubs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_service"
                    android:contentDescription="@string/label_clubs"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_clubs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/label_clubs"
                    android:textColor="@color/white"
                    android:textSize="@dimen/service_label_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/cell_spacing">

                <ImageButton
                    android:id="@+id/btnSupport"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_service"
                    android:contentDescription="@string/label_support"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_support" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/label_support"
                    android:textColor="@color/white"
                    android:textSize="@dimen/service_label_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>